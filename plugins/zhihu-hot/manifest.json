{
  "id": "zhihu-hot",
  "name": "Zhihu Hot List",
  "version": "0.2.0",
  "contractVersion": "2",
  "minHostVersion": "0.2.0",
  "backend": { "entry": "backend/index.js" },
  "ui": { "entry": "web/dist/index.html" },
  "openCliAdapters": {},
  "openCliCommands": {
    "authStatus": {
      "site": "zhihu",
      "adapter": "builtin",
      "command": ["zhihu", "whoami"],
      "strategy": "COOKIE",
      "access": "read",
      "outputFormat": "json"
    },
    "hotQuestions": {
      "site": "zhihu",
      "adapter": "builtin",
      "command": ["zhihu", "hot"],
      "strategy": "COOKIE",
      "access": "read",
      "outputFormat": "json"
    }
  }
}
