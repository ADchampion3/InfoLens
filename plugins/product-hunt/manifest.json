{
  "id": "product-hunt",
  "name": "Product Hunt",
  "version": "0.2.0",
  "contractVersion": "2",
  "minHostVersion": "0.2.0",
  "backend": { "entry": "backend/index.js" },
  "ui": { "entry": "web/dist/index.html" },
  "openCliAdapters": {
    "productHunt": {
      "id": "io.infolens.producthunt",
      "version": "1.0.0",
      "path": "opencli-adapters/producthunt"
    }
  },
  "openCliCommands": {
    "topLaunches": {
      "site": "infolens-producthunt",
      "adapter": "productHunt",
      "command": ["infolens-producthunt", "today"],
      "strategy": "INTERCEPT",
      "access": "read",
      "outputFormat": "json"
    }
  }
}
