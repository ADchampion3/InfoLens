{
  "name": "infolens",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "resources/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/desktop/vite.config.ts",
    "install:opencli": "npm install --prefix resources/opencli --ignore-scripts && node scripts/apply-opencli-overrides.mjs",
    "postinstall": "npm run install:opencli",
    "build": "node scripts/verify-release.mjs && vite build --config apps/desktop/vite.config.ts",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "start": "electron .",
    "test": "npm run package:release && node --test tests/*.test.mjs",
    "test:plugin-runtime-contract": "node --test tests/plugin-runtime-contract.test.mjs",
    "test:public-plugin-persistence": "node --test tests/public-plugin-persistence.test.mjs",
    "test:browser-collection": "node --test tests/browser-collection.test.mjs",
    "test:plugin-task-scheduling": "node --test tests/plugin-task-scheduling.test.mjs",
    "test:plugin-lifecycle": "node --test tests/plugin-lifecycle.test.mjs",
    "test:release-candidate": "npm run package:release && node --test tests/release-candidate.test.mjs",
    "test:release-evidence": "node --test tests/release-evidence.test.mjs",
    "verify:real-source": "node scripts/verify-real-source.mjs",
    "typecheck": "npm run typecheck:desktop && npm run typecheck:sdk",
    "typecheck:desktop": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "typecheck:sdk": "tsc --noEmit -p packages/plugin-sdk/tsconfig.json",
    "plugin": "node packages/plugin-sdk/bin/infolens-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "electron": "^43.2.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
