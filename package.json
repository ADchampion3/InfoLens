{
  "name": "infolens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/desktop/vite.config.ts",
    "acceptance:sprint3": "node scripts/acceptance-sprint3.mjs",
    "live:sprint3": "node scripts/live-sprint3.mjs",
    "install:opencli": "npm install --prefix resources/opencli --ignore-scripts",
    "postinstall": "npm run install:opencli",
    "build": "vite build --config apps/desktop/vite.config.ts",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:sprint1": "node --test tests/sprint1-smoke.test.mjs",
    "test:sprint2": "node --test tests/sprint2-contract.test.mjs",
    "test:sprint3": "node --test tests/sprint3-public-plugins.test.mjs",
    "typecheck": "npm run typecheck:desktop && npm run typecheck:sdk",
    "typecheck:desktop": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "typecheck:sdk": "tsc --noEmit -p packages/plugin-sdk/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "electron": "^43.2.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
